{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@shyzg/discord.js-selfbot",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test": "node --test --test-force-exit test/*.test.js && pnpm run test:typescript",
    "test:typescript": "tsc --noEmit && tsd",
    "lint": "biome check .",
    "format": "biome check --write .",
    "fmt": "pnpm run format",
    "prepack": "pnpm run lint && pnpm run test && node ./scripts/esmDts.mjs"
  },
  "main": "./src/index.js",
  "types": "./typings/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./typings/index.d.mts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./typings/index.d.ts",
        "default": "./src/index.js"
      }
    }
  },
  "directories": {
    "lib": "src",
    "test": "test"
  },
  "files": [
    "src",
    "typings/*.d.ts",
    "typings/*.d.mts"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "api",
    "client",
    "discord",
    "discordapp",
    "discordjs",
    "node",
    "selfbot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shyzg/discord.js-selfbot.git"
  },
  "bugs": {
    "url": "https://github.com/Shyzg/discord.js-selfbot/issues"
  },
  "dependencies": {
    "@discordjs/builders": "^1.15.0",
    "@discordjs/collection": "2.1.1",
    "@discordjs/formatters": "^0.6.2",
    "@discordjs/rest": "^2.6.3",
    "@discordjs/util": "^1.2.0",
    "@discordjs/ws": "^2.0.4",
    "@sapphire/snowflake": "4.0.0",
    "discord-api-types": "^0.38.60",
    "magic-bytes.js": "^1.13.1",
    "qr": "^0.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^24.19.2",
    "tsd": "^0.33.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.22.3"
  }
}
